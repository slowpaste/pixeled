+    /// pixeled: set the IS31FL3741's global current control register.
+    ///
+    /// Scales the current through every LED at once, 0-255, independently of
+    /// the per-LED PWM values - so dimming the panel this way keeps all 256
+    /// PWM steps for the picture, where the brightness setting squeezes them.
+    /// setup() leaves it at 0xFF. The driver crate keeps its register writes
+    /// private, so this is its unlock/page-select/write sequence by hand; the
+    /// page it leaves selected does not matter, as every other write selects
+    /// its own first.
+    pub fn set_global_current(&mut self, current: u8) -> Result<(), I2cError> {
+        let address = self.device.address;
+        // Unlock the page select register, then select page 4 (function).
+        self.device.i2c.write(address, &[0xFE, 0xC5])?;
+        self.device.i2c.write(address, &[0xFD, 0x04])?;
+        // Register 0x01 on page 4 is global current control.
+        self.device.i2c.write(address, &[0x01, current])
+    }
